# Copia este archivo como ".env" en la carpeta frontend/ (opcional para desarrollo local).
# URL base del backend. Si no se define, el frontend llama a rutas relativas "/api",
# lo cual solo funciona cuando el backend sirve el build de producción del frontend.
# Para desarrollo (npm run dev), define la URL completa del backend:
VITE_API_URL=http://localhost:3000/api
