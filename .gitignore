# Dependencias
node_modules/

# Variables de entorno (contienen credenciales, NUNCA se suben)
.env
.env.local
.env.*.local

# Builds
frontend/dist/
frontend/dist-ssr/
backend/dist/

# Dumps de backup de Postgres (se generan en el servidor, no se versionan)
backups/dumps/*
!backups/dumps/.gitkeep

# Override de desarrollo (expone el puerto de Postgres al host). Nunca debe
# llegar al servidor del cliente.
docker-compose.override.yml

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/

# Editor / SO
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Cache
.cache/
*.local
