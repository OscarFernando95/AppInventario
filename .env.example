# Copia este archivo como ".env" en la raíz del proyecto y completa los valores reales.
# Este archivo NUNCA se sube a git (ver .gitignore).
#
# Lo usa docker-compose.yml para levantar los 4 servicios (db, backend, frontend, nginx).

# ─────────────────────────────────────────────────────────────────────────────
# PostgreSQL (contenedor "db")
# ─────────────────────────────────────────────────────────────────────────────
POSTGRES_USER=appinventario
POSTGRES_PASSWORD=cambia_esto_por_una_contrasena_segura
POSTGRES_DB=appinventario

# ─────────────────────────────────────────────────────────────────────────────
# Backend
# ─────────────────────────────────────────────────────────────────────────────
# Clave para firmar los tokens JWT. DEBE tener al menos 32 caracteres o el
# backend no arranca. Genera uno con:  openssl rand -base64 48
JWT_SECRET=cambia_esto_por_un_valor_largo_y_aleatorio_de_32_o_mas

# Orígenes permitidos por CORS, separados por comas. Opcional: en el despliegue
# normal (frontend servido por Nginx en el mismo origen) no hace falta.
# Para desarrollo con Vite:  FRONTEND_URL=http://localhost:5173
# FRONTEND_URL=http://localhost

# Duración del token de sesión (formato de la librería `ms`: "8h", "2h", "7d").
# Opcional; por defecto 8h.
# JWT_EXPIRES_IN=8h
