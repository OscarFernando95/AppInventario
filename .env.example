# Copia este archivo como ".env" en la raíz del proyecto y completa los valores reales.
# Este archivo NUNCA se sube a git (ver .gitignore).
#
# Lo usa docker-compose.yml para levantar los 4 servicios (db, backend, frontend, nginx).

# ─────────────────────────────────────────────────────────────────────────────
# PostgreSQL (contenedor "db")
# ─────────────────────────────────────────────────────────────────────────────
POSTGRES_USER=appinventario
POSTGRES_PASSWORD=cambia_esto_por_una_contrasena_segura
POSTGRES_DB=appinventario

# ─────────────────────────────────────────────────────────────────────────────
# Backend
# ─────────────────────────────────────────────────────────────────────────────
# Clave para firmar los tokens JWT. Usa un valor largo y aleatorio propio.
JWT_SECRET=cambia_esto_por_un_valor_largo_y_aleatorio
