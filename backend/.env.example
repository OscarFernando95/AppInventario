# Copia este archivo como ".env" en la carpeta backend/ y completa los valores reales.
# El archivo .env NUNCA se sube a GitHub (ver .gitignore).

# Puerto en el que corre el servidor backend
PORT=3000

# Clave secreta usada para firmar los tokens JWT (usa un valor largo y aleatorio propio)
JWT_SECRET=cambia_esto_por_un_valor_secreto_y_aleatorio


# ─────────────────────────────────────────────────────────────────────────────
# BASE DE DATOS
# ─────────────────────────────────────────────────────────────────────────────
# Forma recomendada: una única cadena de conexión.
# Si DATABASE_URL está definida, se ignoran las variables DB_* de abajo.
#
# En Docker Compose, el host es "db" (el nombre del servicio de Postgres), no localhost:
#   postgres://usuario:password@db:5432/nombre_bd
#
# Supabase -> Project Settings > Database > Connection string > "Transaction pooler"
# (puerto 6543). Ejemplo:
#   postgresql://postgres.abcdefghijklmno:TU_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# SSL. Desactivado por defecto (Docker/Postgres local no lo necesita).
# Pon "true" únicamente si el destino lo exige (p.ej. Supabase).
DB_SSL=false

# ─────────────────────────────────────────────────────────────────────────────
# Alternativa a DATABASE_URL: variables sueltas (fallback para entorno local).
# Solo se usan si DATABASE_URL está vacía.
# ─────────────────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=AppInventario
DB_USER=postgres
DB_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────────
# Opcionales (tienen valores por defecto razonables; descomenta para ajustar)
# ─────────────────────────────────────────────────────────────────────────────
# DB_ACQUIRE_TIMEOUT_MS=15000     # tiempo máx. para obtener conexión del pool
# DB_STATEMENT_TIMEOUT_MS=15000   # tiempo máx. de una sentencia
# DB_POOL_MAX=5
# DB_POOL_MIN=0
# DB_POOL_IDLE_MS=10000
# DB_LOGGING=false                # "true" para ver el SQL por consola
