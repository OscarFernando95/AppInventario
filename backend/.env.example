# Copia este archivo como ".env" en la carpeta backend/ y completa los valores reales.
# El archivo .env NUNCA se sube a GitHub (ver .gitignore).

# Puerto en el que corre el servidor backend
PORT=3000

# Datos de conexión a la base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=AppInventario
DB_USER=userInventario
DB_PASSWORD=Cambiar*123

# Clave secreta usada para firmar los tokens JWT (usa un valor largo y aleatorio propio)
JWT_SECRET=cambia_esto_por_un_valor_secreto_y_aleatorio
